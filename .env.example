# ==============================================================================
# AAIR LAB - Fullstack Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific credentials.
# NEVER commit the active '.env' file containing secrets to version control.
# ==============================================================================

# Backend Server Configuration
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# Frontend Vite API Base URL
VITE_API_BASE_URL=http://localhost:8080/api

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/aair_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password

# JWT Security Configuration
# CRITICAL: In production, generate a strong random 256-bit key (at least 32 characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRATION_MS=28800000

# Mail Service Configuration (SMTP - used for sending generated passwords to new users)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_system_email@gmail.com
MAIL_PASSWORD=your_google_app_password
MAIL_FROM=your_system_email@gmail.com

# File Storage Configuration
UPLOAD_DIRECTORY=./uploads

# AI Providers API Keys (Optional)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
